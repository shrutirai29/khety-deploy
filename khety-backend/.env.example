PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/khety
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-this-with-a-long-random-secret
PAYMENT_GATEWAY_SECRET=replace-this-with-a-second-long-random-secret
MERCHANT_NAME=Khety Marketplace
MERCHANT_UPI_ID=your-upi-id@bank
MAIL_SERVICE=gmail
MAIL_USER=your-email@example.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@example.com

# Cloudinary (used by /api/upload-image). If these are unset, the code falls
# back to the legacy hardcoded values in config/cloudinary.js so existing
# deployments keep working. Rotate the legacy credentials and set these in
# production (see render-env-notes.md).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
