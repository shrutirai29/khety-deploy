[TEMPLATE]
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/khety
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-this-with-a-long-random-secret
PAYMENT_GATEWAY_SECRET=replace-this-with-a-second-long-random-secret
MERCHANT_NAME=Khety Marketplace
MERCHANT_UPI_ID=your-upi-id@bank
MAIL_SERVICE=gmail
MAIL_USER=your-email@example.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@example.com

# HTTPS email API (RECOMMENDED for Render FREE tier).
# Render free web services BLOCK outbound SMTP ports 25/465/587 (since Sep 2025),
# so nodemailer/Gmail SMTP hangs forever on free plans. Port 443 is allowed, so
# use a transactional email API instead — Brevo (free: 300 emails/day) works.
# Sign up at https://www.brevo.com, verify a sender email, create an API key,
# then set:
MAIL_API_URL=https://api.brevo.com/v3/smtp/email
MAIL_API_KEY=your-brevo-api-key
MAIL_API_FROM=your-sender-email@example.com
MAIL_API_FROM_NAME=Khety

# Cloudinary (used by /api/upload-image). If these are unset, the code falls
# back to the legacy hardcoded values in config/cloudinary.js so existing
# deployments keep working. Rotate the legacy credentials and set these in
# production (see render-env-notes.md).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
